{
  "name": "afterglow-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && esbuild server/index.ts --bundle --format=esm --platform=browser --outfile=dist-worker/index.js --external:cloudflare:*",
    "preview": "wrangler dev --local --ip 127.0.0.1 --host 127.0.0.1 --port 4173 --var DEV_AUTH:local-only",
    "check": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/browser.mjs",
    "test:pwa": "node tests/pwa-layout-browser.mjs",
    "test:capacity": "node tests/capacity-browser.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "git push origin main",
    "icons": "node scripts/icons.mjs",
    "fixtures": "node scripts/fixture.mjs && node scripts/aac-fixture.mjs && node scripts/ogg-fixture.mjs",
    "test:ogg": "node tests/ogg-browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "hono": "^4.10.0",
    "idb": "^8.0.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-range-requests": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.0",
    "miniflare": "4.20260730.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  },
  "packageManager": "pnpm@10.28.0"
}
